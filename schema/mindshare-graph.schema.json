{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://sc2mindshare.local/schema/mindshare-graph.schema.json",
 "title": "Mindshare import document (sc2mindshare build)",
 "description": "CR-018 (T17). The laid-out document sc2mindshare writes: config parts, nodes with size and position, links. Existing properties are required and typed; further properties on existing node types and new node types are allowed (TD-16), so stream 2 can add to the graph without changing this schema first.",
 "type": "object",
 "required": ["visuals", "detail", "dataTypes", "nodes", "links"],
 "additionalProperties": false,
 "properties": {
  "visuals": {"type": "array", "items": {"$ref": "#/$defs/visual"}},
  "detail": {"type": "array", "items": {"$ref": "#/$defs/detail"}},
  "dataTypes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/dataType"}},
  "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
  "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
  "analysis": {"$ref": "#/$defs/analysis"}
 },
 "$defs": {
  "visual": {
   "type": "object",
   "required": ["nodeType", "shape", "borderColor"],
   "properties": {
    "nodeType": {"type": "string"},
    "shape": {"enum": ["circle", "rectangle", "canvas-image"]},
    "borderColor": {"type": "string"}
   }
  },
  "detail": {
   "type": "object",
   "required": ["nodeType", "properties"],
   "properties": {
    "nodeType": {"type": "string"},
    "properties": {"type": "array", "items": {"type": "string"}}
   }
  },
  "dataType": {"enum": ["typelist", "time[h:m:s]", "int", "dec", "bool", "string"]},
  "time": {"type": "string", "description": "h:mm:ss or hh:mm:ss text as the workbook wrote it (B9/B11 kept bug-faithful)"},
  "rectangle": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
  "size": {
   "description": "A circle's radius (Battle, Units) or a rectangle's [width, height], full extents",
   "anyOf": [{"type": "number"}, {"$ref": "#/$defs/rectangle"}]
  },
  "position": {
   "type": "object",
   "required": ["x", "y", "z"],
   "additionalProperties": false,
   "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
  },
  "node": {
   "type": "object",
   "required": ["name", "type", "ID", "size", "properties", "position"],
   "properties": {
    "name": {"type": "string"},
    "description": {"type": "string"},
    "type": {"type": "string"},
    "ID": {"type": "string"},
    "images": {"type": "array", "items": {"type": "string"}},
    "size": {"$ref": "#/$defs/size"},
    "properties": {"type": "object"},
    "position": {"$ref": "#/$defs/position"}
   },
   "allOf": [
    {"if": {"properties": {"type": {"const": "image"}}}, "then": {"$ref": "#/$defs/clock"}, "else": {"required": ["description"]}},
    {"if": {"properties": {"type": {"const": "Battle"}}}, "then": {"properties": {"size": {"type": "number"}, "properties": {"$ref": "#/$defs/battleProperties"}}}},
    {"if": {"properties": {"type": {"const": "Units"}}}, "then": {"properties": {"size": {"type": "number"}, "properties": {"$ref": "#/$defs/unitsProperties"}}}},
    {"if": {"properties": {"type": {"const": "Stats"}}}, "then": {"properties": {"size": {"$ref": "#/$defs/rectangle"}, "properties": {"$ref": "#/$defs/statsProperties"}}}},
    {"if": {"properties": {"type": {"const": "Supply Block"}}}, "then": {"properties": {"size": {"$ref": "#/$defs/rectangle"}, "properties": {"$ref": "#/$defs/supplyBlockProperties"}}}},
    {"if": {"properties": {"type": {"const": "Ability"}}}, "then": {"properties": {"size": {"$ref": "#/$defs/rectangle"}, "properties": {"$ref": "#/$defs/abilityProperties"}}}},
    {"if": {"properties": {"type": {"enum": ["Building", "Initiated"]}}}, "then": {"properties": {"size": {"$ref": "#/$defs/rectangle"}, "properties": {"$ref": "#/$defs/typedTimelineProperties"}}}},
    {"if": {"properties": {"type": {"enum": ["Upgrade", "Chat", "Energy Excess", "Inject Delay", "Harrasment", "Scouting"]}}}, "then": {"properties": {"size": {"$ref": "#/$defs/rectangle"}, "properties": {"$ref": "#/$defs/timelineProperties"}}}},
    {"if": {"properties": {"type": {"enum": ["Game", "Player"]}}}, "then": {"properties": {"size": {"$ref": "#/$defs/rectangle"}}}},
    {"if": {"properties": {"type": {"const": "Game"}}}, "then": {"properties": {"properties": {"$ref": "#/$defs/gameProperties"}}}}
   ]
  },
  "clock": {
   "description": "A clock image node appended by the layout (layout-spec.md §5.9): no description, no properties; CR-069: the picture by its ID on the local Mindshare (nodeImage), named by its file",
   "required": ["nodeImage"],
   "properties": {"size": {"$ref": "#/$defs/rectangle"}, "properties": {"type": "object", "maxProperties": 0}, "nodeImage": {"type": "string"}}
  },
  "timelineProperties": {
   "type": "object",
   "required": ["time", "player"],
   "properties": {"time": {"$ref": "#/$defs/time"}, "player": {"type": "string"}}
  },
  "typedTimelineProperties": {
   "type": "object",
   "required": ["time", "player", "type"],
   "properties": {
    "time": {"$ref": "#/$defs/time"},
    "player": {"type": "string"},
    "type": {"type": "string"}
   }
  },
  "battleProperties": {
   "type": "object",
   "required": ["time", "player", "dead", "p1 dead", "p2 dead", "supply dead", "end time"],
   "properties": {
    "time": {"$ref": "#/$defs/time"},
    "player": {"type": "string"},
    "dead": {"type": "integer"},
    "p1 dead": {"type": "integer"},
    "p2 dead": {"type": "integer"},
    "supply dead": {"type": "number"},
    "end time": {"$ref": "#/$defs/time"}
   }
  },
  "unitsProperties": {
   "type": "object",
   "required": ["time", "player", "type", "count", "total at time", "supply"],
   "properties": {
    "time": {"$ref": "#/$defs/time"},
    "player": {"type": "string"},
    "type": {"type": "string"},
    "count": {"type": "integer"},
    "total at time": {"type": "integer"},
    "supply": {"type": "number"}
   }
  },
  "statsProperties": {
   "type": "object",
   "required": ["time", "player", "workers", "cur. Min", "cur. Gas", "col. rate Min", "col. rate Gas", "army Min", "army Gas", "used Min", "used Gas"],
   "properties": {
    "time": {"$ref": "#/$defs/time"},
    "player": {"type": "string"},
    "workers": {"type": "integer"},
    "cur. Min": {"type": "integer"},
    "cur. Gas": {"type": "integer"},
    "col. rate Min": {"type": "integer"},
    "col. rate Gas": {"type": "integer"},
    "army Min": {"type": "integer"},
    "army Gas": {"type": "integer"},
    "used Min": {"type": "integer"},
    "used Gas": {"type": "integer"}
   }
  },
  "gameProperties": {
   "description": "CR-067 (export fix G2): the Game node's seven properties, in D24a's order",
   "type": "object",
   "required": ["date played (UTC)", "time zone", "length", "game type", "ladder", "category", "speed"],
   "properties": {
    "date played (UTC)": {"type": "string"},
    "time zone": {"type": "string"},
    "length": {"$ref": "#/$defs/time"},
    "game type": {"type": "string"},
    "ladder": {"type": "boolean"},
    "category": {"type": "string"},
    "speed": {"type": "string"}
   }
  },
  "supplyBlockProperties": {
   "type": "object",
   "required": ["time", "player", "duration", "end time"],
   "properties": {
    "time": {"$ref": "#/$defs/time"},
    "player": {"type": "string"},
    "duration": {"type": "integer"},
    "end time": {"$ref": "#/$defs/time"}
   }
  },
  "abilityProperties": {
   "type": "object",
   "required": ["time", "player", "type"],
   "properties": {
    "time": {"$ref": "#/$defs/time"},
    "player": {"type": "string"},
    "type": {"type": "string"},
    "target": {"type": "string", "description": "Only when the ability has a target"}
   }
  },
  "link": {
   "type": "object",
   "required": ["name1", "name2", "direction", "node1", "node2"],
   "properties": {
    "name1": {"type": "string"},
    "name2": {"type": "string"},
    "direction": {"enum": [-1, 0, 1, 2]},
    "node1": {"type": "string"},
    "node2": {"type": "string"},
    "description": {"type": "string"}
   }
  },
  "analysis": {
   "type": "object",
   "description": "Opt-in (sc2mindshare build --with-analysis, CR-021): the analysis values stream 2 reads, as written by export.mindshare_json.analysis_doc from domain/exposed.py; not part of the Mindshare import format",
   "required": ["game", "units", "type_changes", "upgrades", "stats", "supply", "chronos", "tables"],
   "additionalProperties": false,
   "properties": {
    "game": {"$ref": "#/$defs/analysisGame"},
    "units": {"type": "array", "items": {"$ref": "#/$defs/analysisUnit"}},
    "type_changes": {"type": "array", "items": {"$ref": "#/$defs/analysisTypeChange"}},
    "upgrades": {"type": "array", "items": {"$ref": "#/$defs/analysisUpgrade"}},
    "stats": {"type": "array", "items": {"$ref": "#/$defs/analysisStats"}},
    "supply": {"type": "array", "items": {"$ref": "#/$defs/analysisSupply"}},
    "chronos": {"type": "array", "items": {"$ref": "#/$defs/analysisChrono"}},
    "tables": {"$ref": "#/$defs/analysisTables"}
   }
  },
  "analysisGame": {
   "type": "object",
   "required": ["base_build", "version", "loops", "game_type", "team_size", "is_ladder", "players"],
   "additionalProperties": false,
   "properties": {
    "base_build": {"type": "integer"},
    "version": {"type": "string"},
    "loops": {"type": "integer"},
    "game_type": {"type": "string"},
    "team_size": {"type": "integer"},
    "is_ladder": {"type": "boolean"},
    "players": {"type": "array", "items": {"$ref": "#/$defs/analysisPlayer"}}
   }
  },
  "analysisPlayer": {
   "type": "object",
   "required": ["pid", "order", "race", "opponent_race"],
   "additionalProperties": false,
   "properties": {
    "pid": {"type": "integer"},
    "order": {"type": "integer"},
    "race": {"type": "string"},
    "opponent_race": {"type": ["string", "null"]}
   }
  },
  "analysisUnit": {
   "type": "object",
   "required": ["unit_id", "owner", "first_type", "born_loop", "init_loop", "done_loop", "died_loop", "killer", "killing_unit_id", "x", "y", "hallucinated", "base"],
   "additionalProperties": false,
   "properties": {
    "unit_id": {"type": "integer"},
    "owner": {"type": "integer"},
    "first_type": {"type": "string"},
    "born_loop": {"type": ["integer", "null"]},
    "init_loop": {"type": ["integer", "null"]},
    "done_loop": {"type": ["integer", "null"]},
    "died_loop": {"type": ["integer", "null"]},
    "killer": {"type": ["integer", "null"]},
    "killing_unit_id": {"type": ["integer", "null"]},
    "x": {"type": "integer"},
    "y": {"type": "integer"},
    "hallucinated": {"type": "boolean"},
    "base": {"type": ["string", "null"]}
   }
  },
  "analysisTypeChange": {
   "type": "object",
   "required": ["unit_id", "loop", "before", "after"],
   "additionalProperties": false,
   "properties": {
    "unit_id": {"type": "integer"},
    "loop": {"type": "integer"},
    "before": {"type": "string"},
    "after": {"type": "string"}
   }
  },
  "analysisUpgrade": {
   "type": "object",
   "required": ["player", "upgrade", "loop", "count"],
   "additionalProperties": false,
   "properties": {
    "player": {"type": "integer"},
    "upgrade": {"type": "string"},
    "loop": {"type": "integer"},
    "count": {"type": "integer"}
   }
  },
  "analysisStats": {
   "type": "object",
   "required": ["player", "loop", "food_used", "food_made", "workers_active", "minerals", "vespene", "minerals_rate", "vespene_rate", "army_minerals", "army_vespene"],
   "additionalProperties": false,
   "properties": {
    "player": {"type": "integer"},
    "loop": {"type": "integer"},
    "food_used": {"type": "number"},
    "food_made": {"type": "number"},
    "workers_active": {"type": "integer"},
    "minerals": {"type": "integer"},
    "vespene": {"type": "integer"},
    "minerals_rate": {"type": "integer"},
    "vespene_rate": {"type": "integer"},
    "army_minerals": {"type": "integer"},
    "army_vespene": {"type": "integer"}
   }
  },
  "analysisSupply": {
   "type": "object",
   "required": ["player", "time", "supply", "limit"],
   "additionalProperties": false,
   "properties": {
    "player": {"type": "integer"},
    "time": {"type": "string"},
    "supply": {"type": "number"},
    "limit": {"type": "number"}
   }
  },
  "analysisChrono": {
   "type": "object",
   "required": ["player", "loop", "target_unit_id"],
   "additionalProperties": false,
   "properties": {
    "player": {"type": "integer"},
    "loop": {"type": "integer"},
    "target_unit_id": {"type": "integer"}
   }
  },
  "analysisTables": {
   "type": "object",
   "required": ["build_times", "research_times", "units_source_sha256", "upgrades_source_sha256", "unmapped_units", "supplies"],
   "additionalProperties": false,
   "properties": {
    "build_times": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
    "research_times": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
    "units_source_sha256": {"type": "string"},
    "upgrades_source_sha256": {"type": "string"},
    "unmapped_units": {"type": "array", "items": {"type": "string"}},
    "supplies": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
   }
  }
 }
}
