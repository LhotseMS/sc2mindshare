#!/bin/sh
# Run the batch gates on the files the current task owns (G3 is scoped to added
# or changed files; the fork's ruff findings (1,026 on the whole tree at 16beefa, TD-49) are a frozen baseline, see
# docs/dev/baselines.md).
#
#   scripts/gates [PATH ...]      # default: src scripts tests
#
# - ruff check and ruff format --check, with the repository's ruff.toml passed (upstream's
#   vendored pin-conformance tests excluded: they stay byte-identical to v1.9.0)
#   explicitly (line length 129);
# - mypy --strict on the non-test Python files among PATH (tests are not typed);
# - pytest on the tests under PATH, in importlib mode, without a cache.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checkout=$(dirname -- "$script_dir")
py_env="$script_dir/py-env"
venv="$checkout/.venv"
[ "$#" -gt 0 ] || set -- "$checkout/src" "$checkout/scripts" "$checkout/tests"
# Canonical absolute paths (no "." or ".." left), so the excludes below match and mypy can run from a
# fixed folder (D14a; Morgan's G6 on 2053a49). ruff's import order does not depend on the folder it runs
# from: ruff.toml searches no src folders and names sc2mindshare first-party.
# Each path is kept as one positional parameter, so a path with a space stays whole (Vera's G7 probe).
n=$#
for p in "$@"; do
    if [ -d "$p" ]; then
        set -- "$@" "$(CDPATH= cd -- "$p" && pwd)"
    elif [ -e "$p" ]; then
        set -- "$@" "$(CDPATH= cd -- "$(dirname -- "$p")" && pwd)/$(basename -- "$p")"
    else
        echo "gates: no such file or folder: $p" >&2
        exit 2
    fi
done
shift "$n"

status=0
# Files moved verbatim from the legacy layer (CR-011a) keep its findings for now: they are left out
# of ruff and mypy here, and tests/test_lint_baseline.py holds their finding count to its baseline.
legacy_port="$checkout/src/sc2mindshare/analysis/LEGACY_PORT.txt"
# One comma-separated --extend-exclude value, read line by line, so a checkout path with a space stays
# whole (CR-007c carried up: the LEGACY_PORT excludes word-split like the paths did).
port_excludes="$checkout/tests/pin_conformance/test_*.py"
if [ -f "$legacy_port" ]; then
    while IFS= read -r f; do
        case $f in ''|'#'*) continue ;; esac
        port_excludes="$port_excludes,$checkout/$f"
    done < "$legacy_port"
fi
export SC2MS_REQUIRE_GOLDEN=1  # a skipped golden is a failed gate on this Mac (QA design §1.4)
echo "== ruff check"
"$py_env" "$venv/bin/ruff" check --config "$checkout/ruff.toml" --force-exclude --extend-exclude "$port_excludes" "$@" || status=1
echo "== ruff format --check"
"$py_env" "$venv/bin/ruff" format --check --config "$checkout/ruff.toml" --force-exclude --extend-exclude "$port_excludes" "$@" || status=1
echo "== mypy --strict (non-test files)"
# mypy puts the directory it runs from on its import path: run from the checkout root of a tree that has
# the fork's sc2reader/ there (before CR-009), it read that instead of the pinned upstream package (2096
# errors). So it runs from scripts/, with the repository's config passed explicitly. The non-test files are
# listed in Python, never through a word-split shell string (a path with a space stays whole); files moved
# verbatim from the legacy layer (LEGACY_PORT.txt, from CR-011a) are left out.
(cd "$script_dir" && "$py_env" "$venv/bin/python" -I -c '
import pathlib, subprocess, sys
checkout, mypy, *paths = sys.argv[1:]
port = pathlib.Path(checkout, "src/sc2mindshare/analysis/LEGACY_PORT.txt")
skip = set()
if port.exists():
    skip = {str(pathlib.Path(checkout, line.strip())) for line in port.read_text().splitlines() if line.strip() and not line.startswith("#")}
found = set()
for path in map(pathlib.Path, paths):
    found.update([path] if path.is_file() else path.rglob("*.py"))
typed = sorted(str(f) for f in found if f.suffix == ".py" and not f.name.startswith("test_") and f.name != "conftest.py" and str(f) not in skip)
sys.exit(subprocess.call([mypy, "--config-file", checkout + "/pyproject.toml", "--strict", *typed]) if typed else 0)
' "$checkout" "$venv/bin/mypy" "$@") || status=1
echo "== pytest"
"$py_env" "$venv/bin/pytest" -p no:cacheprovider --import-mode=importlib --rootdir="$checkout" -q "$@" || status=1
exit $status
