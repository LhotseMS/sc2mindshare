#!/bin/sh
# Run the old fork's own test suite (legacy/tests) in this checkout's .venv-legacy, from the
# repository root (its tests open replays by root-relative paths). Baseline: 72 tests,
# 65 passed, 4 failed (fork core edits), 3 xfailed (docs/dev/baselines.md).
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checkout=$(dirname -- "$script_dir")
exec "$script_dir/py-env" "$checkout/.venv-legacy/bin/python" -c "
import os, sys, pytest
os.chdir(sys.argv[1])
sys.exit(pytest.main(['-p', 'no:cacheprovider', '-c', os.devnull, '--rootdir', 'legacy', 'legacy/tests', '-q', '-W', 'ignore::DeprecationWarning']))
" "$checkout"
