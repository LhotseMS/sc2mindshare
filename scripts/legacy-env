#!/bin/sh
# (Re)create the legacy environment: the old sc2reader fork with the Mindshare
# layer, used only to produce the legacy golden output (T03) until T24 deletes
# the fork. Shared by every checkout, in <root>/.tools/venvs/legacy.
#
#   scripts/legacy-env            # create or update, install requirements/legacy.lock
#
# The fork is not pip-installed (its setup.py and pyproject.toml disagree on the
# package name); a .pth file puts this checkout's fork tree on sys.path instead.
# After T09 the tree lives in legacy/, and this script points there.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checkout=$(dirname -- "$script_dir")
py_env="$script_dir/py-env"

dir=$checkout
while [ "$dir" != "/" ] && [ ! -d "$dir/.tools" ]; do
    dir=$(dirname -- "$dir")
done
venv="$dir/.tools/venvs/legacy"

if [ -d "$checkout/legacy/sc2reader" ]; then
    fork_root="$checkout/legacy"
else
    fork_root="$checkout"
fi

"$py_env" /opt/homebrew/bin/python3.14 -m venv "$venv"
"$py_env" "$venv/bin/python" -m pip install --quiet -r "$checkout/requirements/legacy.lock"
site=$("$py_env" "$venv/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
printf '%s\n' "$fork_root" > "$site/sc2mindshare_legacy.pth"
"$py_env" "$venv/bin/python" -c 'import sc2reader, sys; print("legacy sc2reader", sc2reader.__version__, "from", sc2reader.__file__)'
