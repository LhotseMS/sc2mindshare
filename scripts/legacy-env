#!/bin/sh
# (Re)create this checkout's legacy environment: the old sc2reader fork with the
# Mindshare layer, used only to produce the legacy golden output (CR-003) until
# T24 deletes the fork. One per checkout, in <checkout>/.venv-legacy, so its
# .pth file can never point at another checkout's fork tree.
#
#   scripts/legacy-env            # create or update from requirements/legacy.lock
#
# The fork is not pip-installed (its setup.py and pyproject.toml disagree on the
# package name); a .pth file puts this checkout's fork tree on sys.path instead.
# After T09 the tree lives in legacy/; the .pth line picks legacy/ or the root when Python starts.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checkout=$(dirname -- "$script_dir")
py_env="$script_dir/py-env"
venv="$checkout/.venv-legacy"


"$py_env" /opt/homebrew/bin/python3.14 -m venv "$venv"
"$py_env" "$venv/bin/python" -m pip install --quiet -r "$checkout/requirements/legacy.lock"
site=$("$py_env" "$venv/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
# an import line, so the fork tree follows the checkout's layout at every start (scripts/legacy_pth.py)
"$py_env" "$venv/bin/python" "$script_dir/legacy_pth.py" "$checkout" > "$site/sc2mindshare_legacy.pth"
"$py_env" "$venv/bin/python" -c 'import sc2reader; print("legacy sc2reader", sc2reader.__version__, "from", sc2reader.__file__)'
